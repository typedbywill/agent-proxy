#!/usr/bin/env bash
#
# agent-proxy: Gerenciador de ciclo de vida e roteamento de modelos de IA
# Wrapper executável que despacha diretamente para a CLI Node.js modular.
# Suporta execução via PATH quando instalado em ~/.local/bin via symlink.
#

set -euo pipefail

# Resolve symlinks para encontrar o diretório físico real do script
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
CLI_INDEX="$SCRIPT_DIR/../src/cli/index.js"

if [ -f "$CLI_INDEX" ]; then
  exec node "$CLI_INDEX" "$@"
else
  echo "Erro: src/cli/index.js não encontrado em $SCRIPT_DIR/../src/cli" >&2
  exit 1
fi
